<h1>New game</h1>

<% @letters.each do |element| %>
<%= element %>
<% end %>

<br>
<br>
<form action="/score" method="post" data-turbo="false" class="row g-3">
  <%= hidden_field_tag :letters, @letters %>
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
   <div class="col-auto">
    <label for="question">Your word</label>
    <input type="text" id="answer" name="word">
    <input type="submit" value="submit!">
   </div>
</form>
